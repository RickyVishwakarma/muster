# Copy to .env and fill in.
# If ANTHROPIC_API_KEY is unset, the app runs in a deterministic "template"
# fallback mode so you can demo the full flow with no key and no network.
ANTHROPIC_API_KEY=

# Model used for chat. Defaults to claude-opus-5.
# For a cheaper/faster demo use claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-5

# SQLite by default (zero-config). To point at Supabase/Postgres instead, set e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./muster.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
