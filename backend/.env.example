# Copy to .env and fill in. Provider is auto-selected by which key is set:
#   Anthropic  →  Gemini  →  OpenRouter  →  offline "template" fallback.
# Or force one explicitly with LLM_PROVIDER below.

# Force a provider: anthropic | gemini | openrouter | template. Empty = auto.
LLM_PROVIDER=

# --- Anthropic (first choice if set) ---
ANTHROPIC_API_KEY=
# Model used for chat. Defaults to claude-opus-5 (claude-haiku-4-5 is cheaper).
ANTHROPIC_MODEL=claude-opus-5

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter (OpenAI-compatible; many free models via ":free" suffix) ---
# Key from https://openrouter.ai/keys (starts with sk-or-...).
# Free slugs rotate — check https://openrouter.ai/models?max_price=0 if one 404s.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Auth: set a long random string in production (e.g. `openssl rand -hex 32`).
SECRET_KEY=dev-insecure-change-me-please

# SQLite by default (zero-config). To point at Supabase/Postgres instead, set e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./muster.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
